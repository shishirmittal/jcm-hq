{
  "regions": [
    "hnd1"
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "rewrites": [
    {
      "source": "/api/cron/daily-email",
      "destination": "/api/orders?h=email"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-email",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "api/db-chat.js": {
      "maxDuration": 60
    },
    "api/collections.js": {
      "maxDuration": 60
    },
    "api/whatsapp.js": {
      "maxDuration": 60
    }
  }
}
